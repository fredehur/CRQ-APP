# ── REQUIRED ──────────────────────────────────────────────────────────────
# The only key the /crq-run pipeline needs. Without it, the run fails (the
# pipeline is live-only — it does not fall back to mock data).
SEERIST_API_KEY=

# ── REQUIRED IF YOU USE OSINT MODE ─────────────────────────────────────────
# /crq-run can optionally include the OSINT physical pillar (web/news enrichment
# via Tavily + Firecrawl). If you turn OSINT on (at /setup or per run) you MUST
# set all three of these, or the run fails loudly. If you never use OSINT, leave blank.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# OSINT enrichment (relevance filtering + summaries) uses Anthropic Haiku.
# Required together with TAVILY/FIRECRAWL whenever OSINT is on; the run fails
# loudly if absent. Not needed if you never use OSINT.
ANTHROPIC_API_KEY=

# Optional: SMTP for automated email delivery. Not needed for /crq-run — that
# flow produces an email.html you open and send yourself.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=
