# ── REQUIRED ──────────────────────────────────────────────────────────────
# The only key the /crq-run pipeline needs. Without it, the run fails (the
# pipeline is live-only — it does not fall back to mock data).
SEERIST_API_KEY=

# ── OPTIONAL — NOT used by /crq-run ────────────────────────────────────────
# These keys are only read by the standalone `tools/osint_physical_collector.py`
# command, which is NOT part of the /crq-run pipeline. The /crq-run flow builds
# briefs from Seerist signals only. Leave these blank unless you are running the
# OSINT collector by hand.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Not needed for the /crq-run Copilot flow — the Copilot agent does the
# analyst/formatter writing. Only relevant if you run a separate CLI path that
# calls the Anthropic API directly.
ANTHROPIC_API_KEY=

# Optional: SMTP for automated email delivery. Not needed for /crq-run — that
# flow produces an email.html you open and send yourself.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_TO=
