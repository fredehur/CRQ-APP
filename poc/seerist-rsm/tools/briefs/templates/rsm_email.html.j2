<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:-apple-system,Segoe UI,system-ui,sans-serif;color:#1a1a1a;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#f4f4f4;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="640" style="max-width:640px;background:#ffffff;border:1px solid #d4d4d4;">

          {# Header band #}
          <tr>
            <td style="background:#0f1419;color:#f4f4f4;padding:18px 20px;font-family:SF Mono,Menlo,Consolas,monospace;font-size:13px;letter-spacing:0.06em;">
              AEROWIND // {{ region }} DAILY // {{ date_z }}
            </td>
          </tr>

          {# Stat strip — V3: counter chips #}
          <tr>
            <td style="background:#1f2937;color:#cbd5e1;padding:10px 20px;font-family:SF Mono,Menlo,Consolas,monospace;font-size:12px;">
              PULSE: {{ pulse_summary }} &nbsp;|&nbsp;
              ADM: {{ admiralty }} &nbsp;|&nbsp;
              NEW:
              <span style="display:inline-block;background:#dbeafe;color:#1e3a8a;padding:1px 7px;border-radius:3px;font-size:11px;font-weight:600;letter-spacing:0.04em;vertical-align:middle;">{{ n_events }} EVT</span>
              <span style="color:#6b7280;font-size:11px;vertical-align:middle;">&nbsp;·&nbsp;</span>
              <span style="display:inline-block;background:#fef3c7;color:#78350f;padding:1px 7px;border-radius:3px;font-size:11px;font-weight:600;letter-spacing:0.04em;vertical-align:middle;">{{ n_hotspots }} HOT</span>
              <span style="color:#6b7280;font-size:11px;vertical-align:middle;">&nbsp;·&nbsp;</span>
              <span style="display:inline-block;background:#ede9fe;color:#5b21b6;padding:1px 7px;border-radius:3px;font-size:11px;font-weight:600;letter-spacing:0.04em;vertical-align:middle;">{{ n_cyber }} CYB</span>
            </td>
          </tr>

          {% for section in sections %}
          <tr>
            {# V6: increased section padding 22px 24px #}
            <td style="padding:22px 24px;border-top:1px solid #e5e5e5;">

              {# V4: section heading — 13px, bold, darker color; accent for PHYSICAL/EARLY WARNING/CYBER #}
              {% if "CYBER" in section.header %}
              <div style="font-family:SF Mono,Menlo,Consolas,monospace;font-size:13px;color:#3b0764;font-weight:600;letter-spacing:0.08em;margin:0 0 10px;">
                █ {{ section.header }}
              </div>
              {% elif "PHYSICAL" in section.header or "EARLY WARNING" in section.header %}
              <div style="font-family:SF Mono,Menlo,Consolas,monospace;font-size:13px;color:#7c2d12;font-weight:600;letter-spacing:0.08em;margin:0 0 10px;">
                █ {{ section.header }}
              </div>
              {% else %}
              <div style="font-family:SF Mono,Menlo,Consolas,monospace;font-size:13px;color:#1f2937;font-weight:600;letter-spacing:0.08em;margin:0 0 10px;">
                █ {{ section.header }}
              </div>
              {% endif %}

              {% if "CYBER" in section.header %}
              {# CYBER section: left-border accent, pre-wrap for tree chars; V8: keep pre-wrap stripped for body #}
              <div style="border-left:3px solid #5b21b6;padding-left:10px;">
                {% set body_lines = section.body.split('\n') %}
                {% if body_lines and body_lines[0].startswith('THREATS ACTIVE:') %}
                <div style="font-size:12px;line-height:1.4;color:#6b7280;font-style:italic;margin:0 0 8px;">{{ body_lines[0] }}</div>
                {# V8: cyber bullets use normal wrap (not pre-wrap); V1+V2 spans already applied in Python #}
                <div style="font-size:14px;line-height:1.8;color:#1a1a1a;">{{ body_lines[1:]|join('<br>') }}</div>
                {% else %}
                <div style="font-size:14px;line-height:1.8;color:#1a1a1a;">{{ section.body.split('\n')|join('<br>') }}</div>
                {% endif %}
              </div>

              {% elif "EXPOSURE" in section.header %}
              {# V5: per-site block with left-border accent; keep pre-wrap for tree chars #}
              {% if section.site_blocks %}
              {% for block in section.site_blocks %}
              <div style="border-left:3px solid #1f2937;padding:8px 0 8px 12px;margin-bottom:8px;font-size:14px;line-height:1.55;color:#1a1a1a;white-space:pre-wrap;">{{ block }}</div>
              {% endfor %}
              {% else %}
              <div style="font-size:14px;line-height:1.55;color:#1a1a1a;white-space:pre-wrap;">{{ section.body }}</div>
              {% endif %}

              {% else %}
              {# V8: PHYSICAL, EARLY WARNING, WATCH, SITUATION — normal wrap, not pre-wrap #}
              {# V1 spans already injected into section.body by Python renderer #}
              <div style="font-size:14px;line-height:1.8;color:#1a1a1a;">{{ section.body.split('\n')|join('<br>') }}</div>
              {% endif %}

            </td>
          </tr>
          {% endfor %}

          {# V7: Footer hierarchy #}
          <tr>
            <td style="background:#fafafa;color:#525252;padding:16px 24px;border-top:1px solid #e5e5e5;font-size:12px;line-height:1.6;">
              <div><strong>Reply with one of:</strong> USEFUL &nbsp;·&nbsp; NOISE &nbsp;·&nbsp; MISSED CONTEXT &nbsp;·&nbsp; FALSE POSITIVE</div>
              <div style="margin-top:6px;color:#737373;font-style:italic;font-size:11px;">+ one sentence on what would make tomorrow's better</div>
              <div style="margin-top:12px;padding-top:10px;border-top:1px solid #e5e5e5;color:#374151;">AEROWIND Intelligence // {{ region }} RSM</div>
              <div style="margin-top:4px;color:#9ca3af;font-style:italic;font-size:11px;">PoC v1 — Seerist live · MED region · cyber pillar via keyword-filtered news + threat-actor watchlist. Feedback welcome at this address.</div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
