<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }} | {{ date_z }}</title>
</head>
<body style="margin:0;padding:0;background:#E3E5E8;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;color:#606D7B;">
  <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#E3E5E8;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="960" style="max-width:960px;background:#FFFFFF;border:1px solid #E3E5E8;">

          <tr>
            <td style="background:#1F3144;padding:10px 28px;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;color:#FFFFFF;letter-spacing:0.12em;text-align:center;font-weight:500;">
              {{ brand }} &nbsp;//&nbsp; {{ region }} DAILY &nbsp;//&nbsp; {{ date_z }}
            </td>
          </tr>

          <tr>
            <td style="padding:18px 28px 14px 28px;border-bottom:1px solid #E3E5E8;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                <tr>
                  <td valign="top" style="padding-right:16px;width:160px;">
                    {% if logo_data_uri %}
                    <img src="{{ logo_data_uri }}" alt="Vestas" width="132" style="display:block;width:132px;height:auto;border:0;">
                    {% else %}
                    <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:24px;line-height:1;color:#005AFF;font-weight:700;">Vestas</div>
                    {% endif %}
                  </td>
                  <td valign="top">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.6;color:#606D7B;">
                      <tr>
                        <td valign="top" width="78" style="color:#A2A9B1;font-size:10px;text-transform:uppercase;padding:2px 0;">From</td>
                        <td valign="top" style="padding:2px 0;color:#1F3144;">{{ region }} RSM &nbsp;<span style="color:#A2A9B1;">/&nbsp; {{ brand }}</span></td>
                      </tr>
                      <tr>
                        <td valign="top" style="color:#A2A9B1;font-size:10px;text-transform:uppercase;padding:2px 0;">Subj</td>
                        <td valign="top" style="padding:2px 0;color:#1F3144;">{{ subject }}</td>
                      </tr>
                      <tr>
                        <td valign="top" style="color:#A2A9B1;font-size:10px;text-transform:uppercase;padding:2px 0;">Date</td>
                        <td valign="top" style="padding:2px 0;color:#1F3144;">{{ date_z }}</td>
                      </tr>
                      <tr>
                        <td valign="top" style="color:#A2A9B1;font-size:10px;text-transform:uppercase;padding:2px 0;">Sources</td>
                        <td valign="top" style="padding:2px 0;color:#1F3144;">OSINT &middot; Seerist signals &middot; threat-actor watchlist</td>
                      </tr>
                      <tr>
                        <td valign="top" style="color:#A2A9B1;font-size:10px;text-transform:uppercase;padding:2px 0;">Handling</td>
                        <td valign="top" style="padding:2px 0;color:#606D7B;font-style:italic;">Internal distribution &middot; do not forward</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:12px 28px;border-bottom:1px solid #E3E5E8;background:#F7F9FC;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;color:#1F3144;text-transform:uppercase;">
              <span style="color:#A2A9B1;">Pulse</span>&nbsp;<span style="font-weight:600;">{{ pulse_summary }}</span>
              <span style="color:#A2A9B1;">&nbsp;&nbsp;|&nbsp;&nbsp;</span>
              <span style="color:#A2A9B1;">ADM</span>&nbsp;<span style="font-weight:600;">{{ admiralty }}</span>
              <span style="color:#A2A9B1;">&nbsp;&nbsp;|&nbsp;&nbsp;</span>
              <span style="color:#A2A9B1;">New</span>
              &nbsp;<span style="display:inline-block;background:#96C8F0;color:#1F3144;padding:2px 8px;font-weight:600;">{{ n_events }} EVT</span>
              <span style="color:#A2A9B1;">&nbsp;&middot;&nbsp;</span>
              <span style="display:inline-block;background:#E3E5E8;color:#1F3144;padding:2px 8px;font-weight:600;">{{ n_hotspots }} HOT</span>
              <span style="color:#A2A9B1;">&nbsp;&middot;&nbsp;</span>
              <span style="display:inline-block;background:#005AFF;color:#FFFFFF;padding:2px 8px;font-weight:600;">{{ n_cyber }} CYB</span>
            </td>
          </tr>

          {% set letters = ['A','B','C','D','E','F','G','H','I','J'] %}
          {% for section in sections %}
          <tr>
            <td style="padding:24px 28px 20px 28px;">
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" {% if not loop.first %}style="border-top:1px solid #E3E5E8;"{% endif %}>
                <tr>
                  <td style="padding-top:{% if loop.first %}0{% else %}18px{% endif %};">
                    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                      <tr>
                        <td valign="top" width="42" style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:#1F3144;">{{ letters[loop.index0] }}.</td>
                        <td valign="top" style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;font-weight:700;color:{% if 'CYBER' in section.header %}#005AFF{% elif 'PHYSICAL' in section.header or 'EARLY WARNING' in section.header %}#1F3144{% elif 'APPENDIX' in section.header %}#606D7B{% else %}#1F3144{% endif %};text-transform:uppercase;">{{ section.header }}</td>
                      </tr>
                    </table>

                    {% if 'APPENDIX' in section.header %}
                    <div style="margin:12px 0 0 42px;">{{ section.appendix_html }}</div>

                    {% elif 'CYBER' in section.header %}
                    <div style="margin:8px 0 0 42px;border-left:3px solid #005AFF;padding-left:12px;">
                      {% set body_lines = section.body.split('\n') %}
                      {% if body_lines and body_lines[0].startswith('THREATS ACTIVE:') %}
                      <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:12px;line-height:1.5;color:#606D7B;margin:0 0 14px;">{{ body_lines[0] }}</div>
                      <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.75;color:#1F3144;">
                        {% for line in body_lines[1:] %}
                        {% if line|trim %}
                        <div style="margin:0 0 12px;">{{ line }}</div>
                        {% endif %}
                        {% endfor %}
                      </div>
                      {% else %}
                      <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.75;color:#1F3144;">
                        {% for line in section.body.split('\n') %}
                        {% if line|trim %}
                        <div style="margin:0 0 12px;">{{ line }}</div>
                        {% endif %}
                        {% endfor %}
                      </div>
                      {% endif %}
                    </div>

                    {% elif 'EXPOSURE' in section.header %}
                    {% if section.site_blocks %}
                    {% for block in section.site_blocks %}
                    <div style="margin:10px 0 0 42px;border-left:3px solid #005AFF;padding:8px 0 8px 12px;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6;color:#1F3144;white-space:pre-wrap;">{{ block }}</div>
                    {% endfor %}
                    {% else %}
                    <div style="margin:10px 0 0 42px;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.7;color:#1F3144;">
                      {% for line in section.body.split('\n') %}
                      {% if line|trim %}
                      <div style="margin:0 0 10px;">{{ line }}</div>
                      {% endif %}
                      {% endfor %}
                    </div>
                    {% endif %}

                    {% else %}
                    <div style="margin:10px 0 0 42px;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:14.5px;line-height:1.7;color:#1F3144;">
                      {% for line in section.body.split('\n') %}
                      {% if line|trim %}
                      <div style="margin:0 0 10px;">{{ line }}</div>
                      {% endif %}
                      {% endfor %}
                    </div>
                    {% endif %}
                  </td>
                </tr>
              </table>
            </td>
          </tr>
          {% endfor %}

          <tr>
            <td style="padding:8px 28px 18px 28px;text-align:center;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;color:#606D7B;border-top:1px solid #E3E5E8;border-bottom:1px solid #E3E5E8;background:#F7F9FC;">
              END OF REPORT
            </td>
          </tr>

          <tr>
            <td style="padding:22px 28px 6px 28px;">
              <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:10px;color:#A2A9B1;text-transform:uppercase;font-weight:600;margin-bottom:8px;">Reply with one of</div>
              <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:12px;color:#1F3144;font-weight:600;line-height:1.6;">USEFUL <span style="color:#A2A9B1;font-weight:400;">&nbsp;&middot;&nbsp;</span> NOISE <span style="color:#A2A9B1;font-weight:400;">&nbsp;&middot;&nbsp;</span> MISSED CONTEXT <span style="color:#A2A9B1;font-weight:400;">&nbsp;&middot;&nbsp;</span> FALSE POSITIVE</div>
              <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:12px;color:#606D7B;font-style:italic;margin-top:8px;">+ one sentence on what would make tomorrow's better.</div>
            </td>
          </tr>

          <tr>
            <td style="padding:18px 28px 24px 28px;">
              <div style="border-top:1px solid #E3E5E8;padding-top:14px;font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:10px;color:#606D7B;text-transform:uppercase;line-height:1.7;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                  <tr>
                    <td valign="top">{{ brand }} &nbsp;//&nbsp; {{ region }} RSM</td>
                    <td valign="top" align="right">{{ date_z }}</td>
                  </tr>
                </table>
                <div style="font-family:VestasSans,Helvetica Neue,Helvetica,Arial,sans-serif;font-size:11px;color:#606D7B;font-style:italic;margin-top:8px;text-transform:none;">Regional risk intelligence - Seerist signals + threat-actor watchlist. Feedback welcome at this address.</div>
              </div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
